{
  "name": "appkit",
  "version": "1.0.0",
  "private": true,
  "description": "A scalable full-stack monorepo starter kit for building multi-app systems with shared UI, backend APIs, and cross-platform frontends.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "pnpm --filter @appkit/api db:generate",
    "db:migrate": "pnpm --filter @appkit/api db:migrate",
    "db:studio": "pnpm --filter @appkit/api db:studio",
    "db:up": "docker compose up -d postgres",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs:api": "docker compose logs -f api",
    "api:docker": "docker compose up api",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@appkit/api",
    "dev:web": "turbo run dev --filter=@appkit/web",
    "dev:desktop": "turbo run build --filter=@appkit/desktop^ && pnpm --filter @appkit/desktop dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "typecheck": "turbo run typecheck",
    "knip": "turbo run knip",
    "package": "turbo run package",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck",
    "lint": "oxlint --type-aware --type-check --ignore-pattern '**/*.config.ts'",
    "format": "oxfmt",
    "knip:desktop": "pnpm --filter @appkit/desktop knip",
    "deps:lint": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:format": "syncpack format",
    "commit": "cross-env NODE_OPTIONS=\"--experimental-transform-types --disable-warning=ExperimentalWarning\" czg",
    "commit:retry": "cross-env NODE_OPTIONS=\"--experimental-transform-types --disable-warning=ExperimentalWarning\" czg --retry",
    "commit:amend": "git commit --amend"
  },
  "dependencies": {
    "syncpack": "^15.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@typescript/native-preview": "7.0.0-dev.20260507.1",
    "cross-env": "^10.1.0",
    "cz-git": "^1.13.0",
    "czg": "^1.13.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.22.1",
    "turbo": "^2.9.10",
    "typescript": "^6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "packageManager": "pnpm@10.33.2"
}
