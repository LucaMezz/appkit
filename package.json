{
  "name": "electron-boilerplate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "pnpm --filter desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck",
    "lint": "oxlint --type-aware --type-check --ignore-pattern '**/*.config.ts'",
    "format": "oxfmt",
    "typecheck": "tsgo --noEmit",
    "knip:desktop": "pnpm --filter desktop knip",
    "knip": "pnpm -r knip"
  },
  "devDependencies": {
    "lefthook": "^2.1.4",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.17.3"
  }
}
