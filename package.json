{
  "name": "electron-boilerplate",
  "productName": "Electron Boilerplate",
  "author": "Jane Doe",
  "version": "1.0.0",
  "description": "Minimal and modern Electron boilerplate with Vite, React, and TypeScript",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run rebuild && npm exec electron-forge package",
    "make": "npm run rebuild && npm exec electron-forge make",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "publish": "electron-forge publish",
    "check": "npm run typecheck && npx biome check --write . && npx prettier --write .",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.node.json",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.1",
    "@hono/node-server": "^1.19.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/vite-react": "^7.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "electron": "^39.1.2",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.10",
    "hono": "^4.10.4",
    "lefthook": "^2.0.3",
    "lucide-react": "^0.553.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "electron-squirrel-startup": "^1.0.1",
    "vite-plugin-native": "^2.2.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.53.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
