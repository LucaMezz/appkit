{
  "name": "appkit",
  "version": "1.0.0",
  "private": true,
  "description": "A scalable full-stack monorepo starter kit for building multi-app systems with shared UI, backend APIs, and cross-platform frontends.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "pnpm --filter @appkit/api db:generate",
    "db:migrate": "pnpm --filter @appkit/api db:migrate",
    "db:studio": "pnpm --filter @appkit/api db:studio",
    "db:up": "docker compose up -d postgres",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs:api": "docker compose logs -f api",
    "api:docker": "docker compose up api",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@appkit/api",
    "dev:web": "turbo run dev --filter=@appkit/web",
    "dev:desktop": "turbo run build --filter=@appkit/desktop^ && pnpm --filter @appkit/desktop dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "typecheck": "turbo run typecheck",
    "knip": "turbo run knip",
    "package": "turbo run package",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck",
    "lint": "oxlint --type-aware --type-check --ignore-pattern '**/*.config.ts'",
    "format": "oxfmt",
    "knip:desktop": "pnpm --filter @appkit/desktop knip"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "lefthook": "^2.1.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.22.1",
    "turbo": "^2.9.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.2"
}
