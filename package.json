{
  "name": "appkit",
  "version": "1.0.0",
  "private": true,
  "description": "A scalable full-stack monorepo starter kit for building multi-app systems with shared UI, backend APIs, and cross-platform frontends.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "pnpm --filter @appkit/api db:generate",
    "db:migrate": "pnpm --filter @appkit/api db:migrate",
    "db:studio": "pnpm --filter @appkit/api db:studio",
    "db:up": "docker compose up -d postgres",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs:api": "docker compose logs -f api",
    "api:docker": "docker compose up api",
    "dev:api": "pnpm --filter @appkit/api dev",
    "dev:desktop": "pnpm --filter @appkit/desktop dev",
    "dev:web": "pnpm --filter @appkit/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck",
    "lint": "oxlint --type-aware --type-check --ignore-pattern '**/*.config.ts'",
    "format": "oxfmt",
    "typecheck": "pnpm -r typecheck",
    "knip:desktop": "pnpm --filter @appkit/desktop knip",
    "knip": "pnpm -r knip",
    "package": "pnpm -r package"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "lefthook": "^2.1.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^6.0.3"
  }
}
