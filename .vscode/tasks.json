{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start API Dev Server",
      "type": "shell",
      "command": "pnpm dev:api",
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🌐 Start Web Dev Server",
      "type": "shell",
      "command": "pnpm dev:web",
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🖥️ Start Desktop Dev App",
      "type": "shell",
      "command": "pnpm dev:desktop",
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "⚡ Start API + Web",
      "dependsOn": ["🚀 Start API Dev Server", "🌐 Start Web Dev Server"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "🧩 Start All Apps",
      "dependsOn": [
        "🚀 Start API Dev Server",
        "🌐 Start Web Dev Server",
        "🖥️ Start Desktop Dev App"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "🏗️ Build All Packages & Apps",
      "type": "shell",
      "command": "pnpm build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "✅ Run Full Check",
      "type": "shell",
      "command": "pnpm check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🔎 Typecheck Workspace",
      "type": "shell",
      "command": "pnpm typecheck",
      "group": "test",
      "problemMatcher": "$tsc"
    },
    {
      "label": "🧹 Lint Workspace",
      "type": "shell",
      "command": "pnpm lint",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "✨ Format Workspace",
      "type": "shell",
      "command": "pnpm format",
      "problemMatcher": []
    },
    {
      "label": "🕵️ Find Unused Code with Knip",
      "type": "shell",
      "command": "pnpm knip",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🖥️ Find Unused Desktop Code with Knip",
      "type": "shell",
      "command": "pnpm knip:desktop",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🧪 Run Tests in Watch Mode",
      "type": "shell",
      "command": "pnpm test",
      "group": "test",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🧪 Run Tests Once",
      "type": "shell",
      "command": "pnpm test:run",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "🐳 Start Docker Services",
      "type": "shell",
      "command": "pnpm docker:up",
      "problemMatcher": []
    },
    {
      "label": "🛑 Stop Docker Services",
      "type": "shell",
      "command": "pnpm docker:down",
      "problemMatcher": []
    },
    {
      "label": "🐳 Build Docker Images",
      "type": "shell",
      "command": "pnpm docker:build",
      "problemMatcher": []
    },
    {
      "label": "📜 Follow API Docker Logs",
      "type": "shell",
      "command": "pnpm docker:logs:api",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🐘 Start Postgres Database",
      "type": "shell",
      "command": "pnpm db:up",
      "problemMatcher": []
    },
    {
      "label": "🧬 Generate Drizzle Migration",
      "type": "shell",
      "command": "pnpm db:generate",
      "problemMatcher": []
    },
    {
      "label": "📦 Apply Database Migrations",
      "type": "shell",
      "command": "pnpm db:migrate",
      "problemMatcher": []
    },
    {
      "label": "🧭 Open Drizzle Studio",
      "type": "shell",
      "command": "pnpm db:studio",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🚢 Run API in Docker",
      "type": "shell",
      "command": "pnpm api:docker",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
