{
  "$schema": "../../node_modules/knip/schema.json",
  "entry": [
    "main/index.ts",
    "preload/index.ts",
    "renderer/src/renderer.tsx",
    "forge.config.ts",
    "vite.main.config.ts",
    "vite.preload.config.ts",
    "vite.renderer.config.ts"
  ],
  "ignore": [
    "forge.env.d.ts",
    "global.d.ts",
    "reset.d.ts",
