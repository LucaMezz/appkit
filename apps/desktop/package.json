{
  "name": "@appkit/desktop",
  "version": "1.0.0",
  "description": "Electron desktop application boilerplate",
  "author": "Luca Mezzavilla",
  "main": ".vite/build/index.js",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "pnpm run rebuild && pnpm exec electron-forge package",
    "make": "pnpm run rebuild && pnpm exec electron-forge make",
    "publish": "pnpm exec electron-forge publish",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test": "vitest",
    "test:run": "vitest run",
    "similarity": "/Users/kimizuy/.cargo/bin/similarity-ts ./src --threshold 0.9 --no-types --print && /Users/kimizuy/.cargo/bin/similarity-ts ./src --types-only --threshold 0.97 --print",
    "postinstall": "lefthook install",
    "knip": "knip"
  },
  "dependencies": {
    "@appkit/api-client": "workspace:*",
    "@appkit/core": "workspace:*",
    "@appkit/ui": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.14.0",
    "react-hook-form": "^7.75.0",
    "react-icons": "^5.6.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-native": "^2.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.3",
    "@hono/node-server": "^1.19.11",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/vite-react": "^7.0.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260324.1",
    "clsx": "^2.1.1",
    "electron": "^42.0.0",
    "happy-dom": "^20.8.8",
    "hono": "^4.12.9",
    "knip": "^6.0.5",
    "lefthook": "^2.1.4",
    "node-abi": "^4.28.0",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^7.2.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "productName": "Electron Boilerplate"
}
