{
  "name": "@appkit/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Shared React UI components for web, desktop, and mobile apps",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:js && pnpm build:types",
    "build:js": "tsup src/index.ts --format esm,cjs --external react --external react-dom --external react/jsx-runtime --external react/jsx-dev-runtime",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --format esm,cjs --watch --external react --external react-dom --external react/jsx-runtime --external react/jsx-dev-runtime",
    "clean": "rimraf dist",
    "typecheck": "tsgo --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "7.0.0-dev.20260507.1",
    "knip": "^6.12.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
