{
  "name": "@appkit/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Shared frontend application routes, pages, and flows for web and desktop apps",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#pages/*": "./src/pages/*.tsx",
    "#routes/*": "./src/routes/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@appkit/api-client": "workspace:*",
    "@appkit/core": "workspace:*",
    "@appkit/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-table": "^8.21.3",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.15.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260507.1",
    "knip": "^6.12.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1"
  }
}
